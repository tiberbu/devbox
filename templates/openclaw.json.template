{
  "models": {
    "providers": {
      "amazon-bedrock": {
        "baseUrl": "https://bedrock-runtime.${BEDROCK_REGION}.amazonaws.com",
        "api": "bedrock-converse-stream",
        "auth": "aws-sdk",
        "models": [
          {
            "id": "${BEDROCK_MODEL}",
            "name": "Claude (Bedrock)",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "${HOME}/.openclaw/workspace",
      "model": {
        "primary": "amazon-bedrock/${BEDROCK_MODEL}"
      },
      "memorySearch": {
        "provider": "bedrock",
        "model": "amazon.titan-embed-text-v2:0"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token"
    },
    "port": ${OPENCLAW_PORT},
    "bind": "loopback",
    "tailscale": {
      "mode": "serve",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true,
      "allowedOrigins": [
        "http://localhost:${OPENCLAW_PORT}",
        "http://127.0.0.1:${OPENCLAW_PORT}"
      ]
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "${DISCORD_BOT_TOKEN}",
      "groupPolicy": "open",
      "ackReactionScope": "all",
      "allowFrom": [],
      "contextVisibility": "all",
      "maxLinesPerMessage": 30,
      "guilds": {
        "${DISCORD_GUILD_ID}": {
          "users": ["${DISCORD_USER_ID}"],
          "requireMention": false
        }
      },
      "streaming": {
        "mode": "block",
        "block": { "enabled": true },
        "chunkMode": "newline"
      },
      "autoPresence": {
        "enabled": true
      },
      "threadBindings": {
        "spawnAcpSessions": true
      }
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "path": "/hooks",
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": { "enabled": true },
        "session-memory": { "enabled": true }
      }
    }
  },
  "tools": {
    "profile": "coding",
    "sessions": {
      "visibility": "all"
    }
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      }
    }
  },
  "plugins": {
    "entries": {
      "amazon-bedrock": {
        "enabled": true,
        "config": {
          "discovery": {
            "enabled": true,
            "region": "${BEDROCK_REGION}",
            "providerFilter": ["anthropic", "amazon"],
            "refreshInterval": 3600
          }
        }
      },
      "anthropic": {
        "enabled": true
      },
      "acpx": {
        "enabled": true,
        "config": {
          "timeoutSeconds": 1800,
          "permissionMode": "approve-all"
        }
      }
    }
  }
}
